# 로컬 테스트용 환경변수 예시. 실제 값은 .env 에 넣거나 GitHub Secrets 에 등록하세요.
# (.env 는 .gitignore 로 커밋되지 않습니다. 비밀번호/키를 깃에 올리지 마세요.)

# Claude API 키 (상승이유 조사 + 개발사 국적 보완에 사용)
ANTHROPIC_API_KEY=sk-ant-...

# 이메일 발송 (Google Workspace SMTP)
SMTP_USER=service@supernewt.co.kr
SMTP_PASS=앱비밀번호16자리            # Google 계정 > 보안 > 앱 비밀번호 에서 발급
MAIL_TO=dragonewt@supernewt.co.kr    # 쉼표로 여러 명 가능

# GitHub Pages 상세페이지 베이스 URL (저장소 만든 뒤 채움)
# 예: https://이용자명.github.io/game-market-research
PAGES_BASE_URL=
